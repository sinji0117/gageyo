# Rpanel API 앱(gageyo-api)의 '환경 변수' 탭에 넣을 값 예시. 전체 설명: docs/configuration.md
# PORT 와 DATABASE_URL 은 Rpanel 이 넣어 줍니다. Redis 는 필요 없습니다.

RUST_LOG=info
ADMIN_EMAILS=ops@gageyo.com
# openssl rand -hex 32 로 만든 값. 한 번 정하면 바꾸지 마세요 (바꾸면 운영자 OTP 를 다시 등록).
DATA_KEY=replace-with-64-hex-chars

APP_URL=https://app.gageyo.com
PARTNER_URL=https://partner.gageyo.com
ADMIN_URL=https://admin.gageyo.com

# 메일 (권장)
SMTP_URL=smtps://no-reply%40gageyo.com:app-password@smtp.gmail.com:465
MAIL_FROM=가게요 <no-reply@gageyo.com>
OPS_EMAIL=ops@gageyo.com

# 토스페이먼츠 (테스트 키로 먼저 확인 → 가맹 계약 후 live 키)
TOSS_CLIENT_KEY=test_ck_replace
TOSS_SECRET_KEY=test_sk_replace

# 비상용 운영자 키 (선택, 긴 임의 값). 쓰지 않으면 지우세요.
# ADMIN_API_KEY=replace-with-a-long-random-secret

# 업로드 폴더는 Rpanel 앱의 data 폴더를 자동으로 찾습니다. 다른 곳을 쓰려면:
# UPLOAD_DIR=/var/lib/rpanel/apps/gageyo-api/data/uploads
