# 로컬 개발용 예시. 복사해서 .env 로 쓰세요 (.env 는 저장소에 올라가지 않습니다).
# 전체 설명: docs/configuration.md

DATABASE_URL=mysql://gageyo_user:devpass@127.0.0.1:3306/gageyo_db
PORT=8081
RUST_LOG=info,gageyo_api=debug

# 운영자 화면에 로그인할 이메일 (쉼표로 구분). 운영자 화면의 '비밀번호 설정 메일 받기'로 처음 비밀번호를 정합니다.
ADMIN_EMAILS=you@example.com
# 비상용 운영자 키 (x-admin-key). 비우면 키 접속을 막습니다.
ADMIN_API_KEY=dev-admin-key-change-me

# 로컬 http 개발에서는 Secure 쿠키를 끕니다 (운영에서는 지우세요).
COOKIE_SECURE=false

# 메일 링크에 쓸 화면 주소 (로컬 개발)
APP_URL=http://localhost:5173
PARTNER_URL=http://localhost:5174
ADMIN_URL=http://localhost:5175

# 비밀값 암호화 키 (openssl rand -hex 32). 운영에서는 꼭 따로 두고 바꾸지 마세요.
# DATA_KEY=

# 메일 (없으면 보내지 않고 로그에만 남김)
# SMTP_URL=smtps://아이디:앱비밀번호@smtp.gmail.com:465
# MAIL_FROM=가게요 <no-reply@gageyo.com>
# OPS_EMAIL=ops@gageyo.com

# 토스페이먼츠 테스트 키 (둘 다 있어야 카드 결제가 켜짐)
# TOSS_CLIENT_KEY=test_ck_...
# TOSS_SECRET_KEY=test_sk_...

# 가입 이메일 인증: auto(메일 설정이 있으면 켬) · on · off
# SIGNUP_EMAIL_VERIFY=auto

# 업로드 이미지 폴더 (기본 data/uploads)
# UPLOAD_DIR=data/uploads
